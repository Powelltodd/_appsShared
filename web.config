<?xml version="1.0" encoding="UTF-8"?>
<!--
  apps/_shared is a PLAIN FOLDER, not its own IIS application, so this is
  inherited config layered on top of wwwroot/web.config. Keep it to the
  minimum that must differ from the parent — every extra section here is a
  chance at a 500.19 override/duplicate conflict for no benefit.

  WHY THIS FILE EXISTS AT ALL, when apps/LiveMeet already has one:
  web.config applies down a folder TREE, and apps/_shared is a SIBLING of
  apps/LiveMeet, not a child of it. Nothing in LiveMeet's config reaches
  here. Before this file, IIS served tnt.css with only Last-Modified and an
  ETag — no Cache-Control at all — so browsers fell back to heuristic
  caching and could hold a stale copy without revalidating.

  That matters more here than anywhere else in the tree: this folder is
  loaded by BOTH apps/LiveMeet and apps/ttJudgeScoring, so one stale copy
  is two apps quietly rendering an old skin, with no error anywhere to say
  so. The failure mode is "my CSS edit did nothing", which costs far more
  to chase than a cache miss costs to serve.

  Deliberately NOT repeated from wwwroot/web.config:
    - the "Extensionless to html" rewrite rule
    - the .js mimeMap (application/javascript; charset=UTF-8)
    - request size limits
-->
<configuration>
  <system.webServer>

    <staticContent>
      <!-- Don't let browsers cache anything in this folder. Matches
           apps/LiveMeet/web.config and apps/ttJudgeScoring/web.config so
           all three behave the same way while the apps are in development.

           Revisit at deploy time TOGETHER WITH those two, not on its own —
           a shared asset that caches while its consumers do not (or the
           reverse) is how the two apps end up rendering different versions
           of the same panel. -->
      <clientCache cacheControlMode="DisableCache" />

      <!-- The parent maps .js to UTF-8 but says nothing about .html, so
           the two shared fragments (TNTDialogs.html, TNTTemplates.html)
           would fall through to the IIS default of ISO-8859-1. An HTTP
           charset OVERRIDES a document's own <meta charset>, so their
           UTF-8 content would be decoded as Latin-1.

           These two are fetched as fragments through TeamRest's
           GetHtmlPage rather than served directly, so this is belt and
           braces rather than a fix for an observed bug — but it costs
           nothing and removes a trap for anyone who opens them directly.

           <remove> first is REQUIRED: .html is in the inherited collection
           (from applicationHost.config's defaults), and adding a duplicate
           without removing it is a 500.19. Note this is the opposite of
           the trap called out in apps/LiveMeet/web.config, which is about
           <remove>-ing an entry that is NOT inherited. -->
      <remove fileExtension=".html" />
      <mimeMap fileExtension=".html" mimeType="text/html; charset=UTF-8" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!-- clientCache above sets Cache-Control; these add Pragma+Expires
             for older intermediaries. -->
        <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        <add name="Pragma"        value="no-cache" />
        <add name="Expires"       value="0" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
